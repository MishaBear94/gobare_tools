{
  "name": "@gobare/tools",
  "version": "0.1.1",
  "packageManager": "pnpm@11.5.1",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "gobare": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test dist/*.test.js",
    "fixture:pi-import": "pnpm build && node dist/pi-import-fixture.js",
    "release:pack": "pnpm build && node scripts/prepare-release.mjs",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.81.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.8.3"
  }
}
